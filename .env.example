# Local Yahoo sign-in: create your own Yahoo developer app with Fantasy Sports
# read access. Put the real values in .env.local (gitignored), then restart Vite.
# Never prefix these credentials with VITE_: they belong only on the server.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
FRONTEND_URL=http://127.0.0.1:5173
# Must exactly match the callback registered in your Yahoo developer app.
# Set this when using a registered HTTPS callback on your own Yahoo service.
YAHOO_REDIRECT_URI=

# Empty means use the local Yahoo handlers included in npm run dev.
# For a hosted install, use your own Yahoo API deployment origin here.
VITE_YAHOO_API_URL=
# Hosted service only: set ALLOW_DEV_OAUTH=1 to permit local development returns.
# See docs/YAHOO_SETUP.md for local setup and deployment requirements.

# Optional development league shortcuts. Never commit real ESPN session cookies.
VITE_DEV_SLEEPER_LEAGUE_ID=
VITE_DEV_ESPN_LEAGUE_ID=
VITE_DEV_ESPN_SEASON=2026
VITE_DEV_ESPN_S2=
VITE_DEV_ESPN_SWID=
